% econometralab.sty
% Tema de Beamer para Económetra Lab — Universidad de Pamplona
% Enfoque académico y formal, con identidad visual propia.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{econometralab}[2026/08/25 Tema Beamer Econometra Lab]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{booktabs}
\RequirePackage{amssymb}
\RequirePackage{amsmath}

% ---------------------------------------------------------------------------
% Paleta de color (misma identidad del repositorio Econometra Lab)
% ---------------------------------------------------------------------------
\definecolor{elBlueDeep}{HTML}{1E40AF}
\definecolor{elBlue}{HTML}{3B82F6}
\definecolor{elCyan}{HTML}{06B6D4}
\definecolor{elDark}{HTML}{1E293B}
\definecolor{elGray}{HTML}{64748B}
\definecolor{elLight}{HTML}{F1F5F9}

\setbeamercolor{palette primary}{bg=elBlueDeep,fg=white}
\setbeamercolor{palette secondary}{bg=elBlue,fg=white}
\setbeamercolor{palette tertiary}{bg=elCyan,fg=white}
\setbeamercolor{structure}{fg=elBlueDeep}
\setbeamercolor{title}{fg=white}
\setbeamercolor{frametitle}{fg=elDark}
\setbeamercolor{normal text}{fg=elDark}
\setbeamercolor{block title}{bg=elBlueDeep,fg=white}
\setbeamercolor{block body}{bg=elLight,fg=elDark}
\setbeamercolor{block title alerted}{bg=elCyan,fg=white}
\setbeamercolor{block body alerted}{bg=elLight,fg=elDark}
\setbeamercolor{itemize item}{fg=elCyan}
\setbeamercolor{itemize subitem}{fg=elBlue}
\setbeamercolor{footline}{fg=elGray}
\setbeamercolor{page number in head/foot}{fg=elGray}

% ---------------------------------------------------------------------------
% Tipografía
% ---------------------------------------------------------------------------
\setbeamerfont{frametitle}{series=\bfseries,size=\Large}
\setbeamerfont{title}{series=\bfseries,size=\huge}
\setbeamertemplate{navigation symbols}{}

% Viñetas propias
\setbeamertemplate{itemize item}{\raisebox{0.15ex}{\small$\blacktriangleright$}}
\setbeamertemplate{itemize subitem}{\raisebox{0.15ex}{\footnotesize$\triangleright$}}

% ---------------------------------------------------------------------------
% Título de diapositiva con barra de acento
% ---------------------------------------------------------------------------
\setbeamertemplate{frametitle}{
  \vspace{0.3cm}
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}
  \vspace{0.15cm}
  \begin{tikzpicture}
    \draw[elCyan, line width=2pt] (0,0) -- (2.2,0);
    \draw[elBlueDeep, line width=2pt] (2.25,0) -- (\dimexpr\textwidth-2pt\relax,0);
  \end{tikzpicture}
}

% ---------------------------------------------------------------------------
% Pie de página
% ---------------------------------------------------------------------------
\newcommand{\elCourseShort}{}
\newcommand{\setElCourseShort}[1]{\renewcommand{\elCourseShort}{#1}}

\setbeamertemplate{footline}{
  \leavevmode
  \hbox{
    \begin{beamercolorbox}[wd=.34\paperwidth,ht=2.5ex,dp=1.5ex,left,leftskip=1em]{footline}
      \fontsize{5.5}{6}\selectfont \elCourseShort
    \end{beamercolorbox}
    \begin{beamercolorbox}[wd=.34\paperwidth,ht=2.5ex,dp=1.5ex,center]{footline}
      \fontsize{5.5}{6}\selectfont Económetra Lab
    \end{beamercolorbox}
    \begin{beamercolorbox}[wd=.3\paperwidth,ht=2.5ex,dp=1.5ex,right,rightskip=1em]{footline}
      \fontsize{5.5}{6}\selectfont \insertframenumber\,/\,\inserttotalframenumber
    \end{beamercolorbox}
  }
  \vspace{2pt}
}

% ---------------------------------------------------------------------------
% Portada
% ---------------------------------------------------------------------------
\newcommand{\elUniversity}{Universidad de Pamplona}
\newcommand{\elDepartment}{Departamento de Economía}
\newcommand{\elCourse}{}
\newcommand{\elUnit}{}
\newcommand{\elProfessor}{}
\newcommand{\elTerm}{}

\newcommand{\setElCourse}[1]{\renewcommand{\elCourse}{#1}}
\newcommand{\setElUnit}[1]{\renewcommand{\elUnit}{#1}}
\newcommand{\setElProfessor}[1]{\renewcommand{\elProfessor}{#1}}
\newcommand{\setElTerm}[1]{\renewcommand{\elTerm}{#1}}

\renewcommand{\maketitle}{
\begin{frame}[plain]
  \begin{tikzpicture}[overlay, remember picture]
    \fill[elBlueDeep] (current page.south west) rectangle (current page.north east);
    \fill[elCyan, opacity=0.18]
      (current page.north west) --
      ($(current page.north west)!0.35!(current page.north east)$) --
      ($(current page.south west)!0.55!(current page.south east)$) --
      (current page.south west) -- cycle;
    \node[anchor=north west, xshift=1cm, yshift=-0.9cm, text width=0.85\paperwidth, align=left] at (current page.north west) {
      \color{white}\small\bfseries \elDepartment\ \textperiodcentered\ \elUniversity
    };
    \node[anchor=center, text width=0.85\paperwidth, align=left] at (current page.center) {
      \color{white}
      {\Huge\bfseries \elCourse}\\[0.4cm]
      {\Large \elUnit}\\[1cm]
      {\large \elProfessor}\\
      {\normalsize \elTerm}
    };
  \end{tikzpicture}
\end{frame}
}

% ---------------------------------------------------------------------------
% Diapositiva de sección (fondo de color, útil para separar unidades/temas)
% ---------------------------------------------------------------------------
\setbeamertemplate{section page}{
  \begin{tikzpicture}[overlay, remember picture]
    \fill[elBlueDeep] (current page.south west) rectangle (current page.north east);
    \node[anchor=center, text width=0.8\paperwidth, align=left] at (current page.center) {
      \color{elCyan}\large\bfseries \insertsectionnumber.\ \ \color{white}\Large\bfseries\insertsection
    };
  \end{tikzpicture}
}

\AtBeginSection[]{
  \begin{frame}[plain,noframenumbering]
    \usebeamertemplate{section page}
  \end{frame}
}

\endinput
